# Env & secrets
.env
.env.*
!.env.example
*.local

# Supabase CLI local state — `supabase link` writes the remote project ref here. Never commit it.
supabase/.temp/
supabase/.branches/

# Node
node_modules/
dist/
build/
.next/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Data (keep large source dumps out of git)
data/raw/
*.zip

# OS / editor
.DS_Store
.vscode/
.idea/

# Ad-hoc manual verification captures (scratch, not repo content)
screenshots/
screenshot/

# Playwright oracle-harness output (the specs are tracked; the run artifacts are not)
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/

# Source design files kept locally only, not tracked (e.g. favicon_io/)
assets/
